<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_widget_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/datetime_time_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/date_temperate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="left|bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HH:MM"
                    android:textColor="@android:color/black"
                    android:textSize="60sp"
                    android:textStyle="bold" />

                <!-- Khối chứa pin và nhiệt độ, nằm dọc và căn phải -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Phần hiển thị pin (căn phải) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left|center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/battery_icon_image_view"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Mức pin"
                            android:src="@drawable/ic_battery"
                            android:tint="@android:color/black" />

                        <TextView
                            android:id="@+id/battery_info_text_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="4dp"
                            android:text="--%"
                            android:textColor="@android:color/black"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="100%" />
                    </LinearLayout>

                    <!-- Nhiệt độ (căn trái) -->
                    <TextView
                        android:id="@+id/temperate_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="37C"
                        android:textColor="@android:color/black"
                        android:textSize="34sp"
                        android:textStyle="bold|italic" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_volume"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center_vertical"
                    android:backgroundTint="#dcdcdc"
                    android:contentDescription="Điều chỉnh âm lượng"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_volume" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/time_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|left"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/date_text_view"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:text="Thứ, DD/MM/YYYY"
                    android:textColor="@android:color/black"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/weather_text_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:gravity="center|top"
                    android:text="Nắng"
                    android:textColor="@android:color/black"
                    android:textSize="24sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_grid_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_widget_area"
        tools:listitem="@layout/item_app" />

</androidx.constraintlayout.widget.ConstraintLayout>